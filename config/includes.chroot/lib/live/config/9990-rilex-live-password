#!/bin/sh
# Called by live-config after its generated live account. The installed account
# is created by Calamares and never receives a predetermined password.
set -eu
# live-config SDDM component writes an empty session for unknown desktops.
# The explicit live-only drop-in selects the packaged Rilex session instead.
rm -f /etc/sddm.conf
if getent passwd live >/dev/null; then
 passwd --lock live
fi
