#!/bin/sh
set -eu
if [ ! -f /run/live/medium/live/filesystem.squashfs ]; then
    printf '%s\n' 'Install Rilex is available only in the live session.' >&2
    exit 1
fi
# Debian live-config grants the disposable live user passwordless sudo.
# Use XWayland: a root Qt Wayland client cannot access the user's Wayland socket.
# The installer itself still requires its interactive destructive confirmation.
sudo -n true
xhost +si:localuser:root
cleanup() {
    xhost -si:localuser:root >/dev/null 2>&1 || true
    if [ -f /etc/fstab.orig.rilex ]; then
        sudo -n mv /etc/fstab.orig.rilex /etc/fstab
    fi
}
trap cleanup EXIT HUP INT TERM
# The Debian wrapper removes live-build's stale fstab before partition probing.
if [ -f /etc/fstab ]; then
    sudo -n mv /etc/fstab /etc/fstab.orig.rilex
fi
sudo -n env DISPLAY="${DISPLAY:?XWayland DISPLAY is required}" QT_QPA_PLATFORM=xcb QT_AUTO_SCREEN_SCALE_FACTOR=1 calamares
