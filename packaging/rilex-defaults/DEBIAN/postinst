#!/bin/sh
set -e
if [ "$1" = configure ]; then
 # SDDM preselects Last.Session; seed first install, preserve subsequent choices.
 sddm_home=$(getent passwd sddm | cut -d: -f6)
 if [ -n "$sddm_home" ] && [ ! -s "$sddm_home/state.conf" ]; then
  install -d -o sddm -g sddm -m 0750 "$sddm_home"
  printf '[Last]\nSession=rilex.desktop\n' > "$sddm_home/state.conf"
  chown sddm:sddm "$sddm_home/state.conf"
  chmod 0600 "$sddm_home/state.conf"
 fi
 # Upgrades preserve administrator service and default-target choices.
 if [ -z "${2:-}" ]; then
  systemctl enable NetworkManager.service bluetooth.service sddm.service 2>/dev/null || true
  systemctl set-default graphical.target 2>/dev/null || true
 fi
fi
