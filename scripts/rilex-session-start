#!/bin/sh
set -eu
export XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland XDG_SESSION_TYPE=wayland
# SDDM establishes the session bus; retain the desktop if optional services fail.
if ! dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE HYPRLAND_INSTANCE_SIGNATURE; then
 logger -t rilex-session 'Could not import Wayland environment into D-Bus/systemd; portals may fail'
fi
if ! systemctl --user start pipewire.socket pipewire-pulse.socket wireplumber.service; then
 logger -t rilex-session 'Could not start audio services; inspect systemctl --user status'
fi
# A compositor session does not execute desktop-environment XDG autostarts.
# Create localized standard folders once and honor existing user choices.
if ! xdg-user-dirs-update; then
 logger -t rilex-session 'Could not initialize standard user directories'
fi
rilex-bar &
mako &
rilex-wallpaper &
/usr/libexec/polkit-mate-authentication-agent-1 &
wl-paste --type text --watch cliphist store &
wl-paste --type image --watch cliphist store &
state=${XDG_STATE_HOME:-"$HOME/.local/state"}/rilex
mkdir -p "$state"
if [ ! -f "$state/welcome-seen" ]; then
 rilex-terminal --title=Rilex-Welcome rilex-welcome &
fi
wait
